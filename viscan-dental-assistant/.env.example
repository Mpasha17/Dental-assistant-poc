# Copy to .env. Empty keys are fine: the app falls back to the rule interpreter
# and the mock speech adapter, which is also how the test suite runs.

# gemini | mistral | groq | rule
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# groq | local | mock
STT_PROVIDER=groq
LOCAL_WHISPER_MODEL=base.en
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

LLM_TIMEOUT_S=15
LOG_LEVEL=INFO

# Slots and words like "tomorrow" are resolved against this fixed demo date.
DEMO_DATE=2026-10-14
